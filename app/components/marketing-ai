"use client";

import { useState, useRef } from "react";

type ChatMessage = {
  role: "user" | "assistant";
  content: string;
};

export default function MarketingAI() {
  const [message, setMessage] = useState("");
  const [loading, setLoading] = useState(false);

  const inputRef = useRef<HTMLTextAreaElement>(null);

  const [messages, setMessages] = useState<ChatMessage[]>([
    {
      role: "assistant",
      content:
        "👋 Hi! I'm Nova, your AI Marketing Manager. How can I help grow your business today?",
    },
  ]);

  async function ask() {
    if (!message.trim()) return;

    const userMessage = message;

    setMessages((prev) => [
      ...prev,
      {
        role: "user",
        content: userMessage,
      },
    ]);

    setMessage("");
    setLoading(true);

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          messages: [
            {
              role: "user",
              content: `You are Nova, BrandPilot's AI Marketing Manager.

Help businesses with:
- Marketing Strategy
- SEO
- Google Ads
- Meta Ads
- Social Media
- Branding
- Email Marketing
- Content Planning
- Competitor Analysis

User:
${userMessage}`,
            },
          ],
        }),
      });

      const data = await res.json();

      setMessages((prev) => [
        ...prev,
        {
          role: "assistant",
          content:
            data.reply || "Sorry, I couldn't generate a response.",
        },
      ]);
    } catch {
      setMessages((prev) => [
        ...prev,
        {
          role: "assistant",
          content: "❌ Something went wrong. Please try again.",
        },
      ]);
    } finally {
      setLoading(false);

      setTimeout(() => {
        inputRef.current?.focus();
      }, 100);
    }
  }

  return (
    <section className="py-24 px-6 min-h-screen">

      <div className="max-w-4xl mx-auto">

        {/* NOVA HEADER */}
        <div className="flex flex-col items-center text-center">

          <img
            src="/nova.png"
            alt="Nova"
            className="w-32 h-32 rounded-full border-4 border-blue-500 object-cover shadow-2xl"
          />

          <h1 className="text-5xl font-bold mt-6">
            Nova
          </h1>

          <p className="text-xl text-blue-400 mt-2">
            AI Marketing Manager
          </p>

          <p className="text-gray-400 mt-3">
            Your AI marketing expert for SEO, Ads, Social Media & Business Growth.
          </p>

          <div className="mt-4 flex items-center gap-2 bg-green-500/10 border border-green-500/30 px-4 py-2 rounded-full">
            <span className="w-3 h-3 bg-green-400 rounded-full animate-pulse"></span>
            <span className="text-green-400">
              Online
            </span>
          </div>

        </div>


        {/* QUICK QUESTIONS */}
        <div className="mt-8">

          <p className="text-gray-400 mb-3">
            Quick Questions
          </p>

          <div className="flex flex-wrap gap-3">

            <button
              onClick={() =>
                setMessage("Create a marketing campaign for my business")
              }
              className="px-4 py-2 rounded-full bg-white/10 hover:bg-blue-500 transition"
            >
              🚀 Marketing Campaign
            </button>


            <button
              onClick={() =>
                setMessage("Generate a complete SEO strategy")
              }
              className="px-4 py-2 rounded-full bg-white/10 hover:bg-blue-500 transition"
            >
              🔍 SEO Plan
            </button>


            <button
              onClick={() =>
                setMessage("Create 30 Instagram content ideas")
              }
              className="px-4 py-2 rounded-full bg-white/10 hover:bg-blue-500 transition"
            >
              📱 Social Media
            </button>

          </div>

        </div>



        {/* CHAT HISTORY */}
        <div className="mt-10 bg-black/30 rounded-2xl p-6 h-[450px] overflow-y-auto space-y-4">

          {messages.map((msg, index) => (

            <div
              key={index}
              className={`flex items-start gap-3 ${
                msg.role === "user"
                  ? "justify-end"
                  : "justify-start"
              }`}
            >

              {msg.role === "assistant" && (
                <img
                  src="/nova.png"
                  alt="Nova"
                  className="w-10 h-10 rounded-full"
                />
              )}


              <div
                className={`max-w-[75%] px-4 py-3 rounded-2xl ${
                  msg.role === "user"
                    ? "bg-blue-500 text-white"
                    : "bg-white/10 text-gray-200"
                }`}
              >
                {msg.content}
              </div>


              {msg.role === "user" && (
                <div className="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center font-bold">
                  U
                </div>
              )}

            </div>

          ))}


          {loading && (
            <div className="bg-white/10 px-4 py-3 rounded-2xl w-fit">
              Nova is typing...
            </div>
          )}

        </div>




        {/* MESSAGE BOX */}
        <div className="mt-8 bg-white/5 border border-white/10 rounded-3xl p-6">

          <div className="relative">

            <textarea
              ref={inputRef}
              value={message}
              onChange={(e) =>
                setMessage(e.target.value)
              }
              onKeyDown={(e) => {

                if(e.key === "Enter" && !e.shiftKey){
                  e.preventDefault();
                  ask();
                }

              }}
              placeholder="Ask Nova anything..."
              className="w-full h-32 rounded-2xl bg-black/40 border border-white/10 p-5 pr-24 text-white placeholder:text-gray-500 focus:outline-none focus:border-blue-500 resize-none"
            />


            <button
              onClick={ask}
              disabled={loading}
              className="absolute bottom-4 right-4 bg-blue-500 hover:bg-blue-600 disabled:opacity-50 w-14 h-14 rounded-xl flex items-center justify-center text-2xl transition"
            >
              {loading ? "..." : "➤"}
            </button>


          </div>

        </div>


      </div>

    </section>
  );
}
